{
  "name": "@open-ontology/stress",
  "version": "0.1.0",
  "private": true,
  "description": "Performance and stress tests for @open-ontology/core",
  "type": "module",
  "scripts": {
    "stress-test": "vitest run",
    "stress-test:kv": "STRESS_BACKEND=kv STRESS_UPDATE_ROUNDS=0 NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "stress-test:fdb": "STRESS_BACKEND=fdb STRESS_UPDATE_ROUNDS=0 NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "benchmark": "tsx scripts/generate-benchmark-report.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist stress-data benchmark-results-*.json"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@open-ontology/core": "workspace:*",
    "@open-ontology/database": "workspace:*",
    "@open-ontology/database-foundationdb": "workspace:*",
    "@open-ontology/database-postgres": "workspace:*",
    "@open-ontology/database-sqlite": "workspace:*",
    "@open-ontology/domain": "workspace:*",
    "@open-ontology/runtime": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "testcontainers": "^11.12.0",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
