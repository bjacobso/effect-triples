{
  "name": "effect-triples-stress",
  "version": "0.1.0",
  "private": true,
  "description": "Performance and stress tests for Effect Triples data backends",
  "type": "module",
  "scripts": {
    "stress-test": "vitest run",
    "stress-test:kv": "STRESS_BACKEND=kv STRESS_UPDATE_ROUNDS=0 NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "stress-test:fdb": "STRESS_BACKEND=fdb STRESS_UPDATE_ROUNDS=0 NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "benchmark": "tsx scripts/generate-benchmark-report.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist stress-data benchmark-results-*.json"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/rpc": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "effect": "catalog:",
    "effect-triples": "workspace:^",
    "effect-triples-foundationdb": "workspace:^",
    "effect-triples-postgres": "workspace:^",
    "effect-triples-sql": "workspace:^",
    "effect-triples-sqlite": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "testcontainers": "^11.12.0",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
