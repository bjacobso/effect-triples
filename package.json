{
  "name": "config-graph",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.1.3"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown --clean",
    "dev": "tsdown --watch --no-clean",
    "lint": "oxlint src explorer bench tsdown.config.ts tsdown.explorer.config.ts vitest.config.ts",
    "clean": "rm -rf dist",
    "test": "vitest --run",
    "bench:typecheck": "node bench/typecheck-budget.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.explorer.json",
    "explorer": "tsdown --config tsdown.explorer.config.ts && node explorer/smoke.mjs"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "20.19.27",
    "oxlint": "1.77.0",
    "tsdown": "0.15.6",
    "typescript": "npm:@typescript/typescript6@6.0.1",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "4.1.11"
  }
}
