{
  "name": "triplex-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "An Effect-native fact database with Datalog and typed, content-addressed configuration.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "clean": "turbo run clean",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm docs:check && pnpm test && pnpm build",
    "dev": "turbo watch build",
    "docs:check": "node scripts/check-markdown-code.mjs",
    "example:compliance-host": "pnpm --filter triplex-compliance-host start",
    "example:demo": "pnpm --filter triplex-demo start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "pack:check": "node scripts/check-packages.mjs",
    "release:publish": "pnpm build && pnpm pack:check && changeset publish",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "test": "turbo run test",
    "test:foundationdb:integration": "pnpm --filter @bjacobso/triplex-foundationdb test:integration",
    "test:postgres:integration": "pnpm --filter @bjacobso/triplex-postgres test:integration",
    "test:watch": "turbo watch test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0"
}
