{
  "name": "@open-ontology/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./Datalog": {
      "import": "./dist/Datalog.js",
      "types": "./dist/Datalog.d.ts",
      "default": "./src/Datalog.ts"
    },
    "./datalog": {
      "import": "./dist/Datalog.js",
      "types": "./dist/Datalog.d.ts",
      "default": "./src/Datalog.ts"
    },
    "./DatalogRpc": {
      "import": "./dist/DatalogRpc.js",
      "types": "./dist/DatalogRpc.d.ts",
      "default": "./src/DatalogRpc.ts"
    },
    "./DatalogApi": {
      "import": "./dist/DatalogApi.js",
      "types": "./dist/DatalogApi.d.ts",
      "default": "./src/DatalogApi.ts"
    },
    "./Database": {
      "import": "./dist/Database.js",
      "types": "./dist/Database.d.ts",
      "default": "./src/Database.ts"
    },
    "./DatabaseApi": {
      "import": "./dist/DatabaseApi.js",
      "types": "./dist/DatabaseApi.d.ts",
      "default": "./src/DatabaseApi.ts"
    },
    "./DatabaseRpc": {
      "import": "./dist/DatabaseRpc.js",
      "types": "./dist/DatabaseRpc.d.ts",
      "default": "./src/DatabaseRpc.ts"
    },
    "./Sparql": {
      "import": "./dist/Sparql.js",
      "types": "./dist/Sparql.d.ts",
      "default": "./src/Sparql.ts"
    },
    "./Snapshot": {
      "import": "./dist/Snapshot.js",
      "types": "./dist/Snapshot.d.ts",
      "default": "./src/Snapshot.ts"
    },
    "./SnapshotApi": {
      "import": "./dist/SnapshotApi.js",
      "types": "./dist/SnapshotApi.d.ts",
      "default": "./src/SnapshotApi.ts"
    },
    "./Triple": {
      "import": "./dist/Triple.js",
      "types": "./dist/Triple.d.ts",
      "default": "./src/Triple.ts"
    },
    "./TripleRpc": {
      "import": "./dist/TripleRpc.js",
      "types": "./dist/TripleRpc.d.ts",
      "default": "./src/TripleRpc.ts"
    },
    "./TripleApi": {
      "import": "./dist/TripleApi.js",
      "types": "./dist/TripleApi.d.ts",
      "default": "./src/TripleApi.ts"
    },
    "./subscriptions": {
      "import": "./dist/subscriptions/index.js",
      "types": "./dist/subscriptions/index.d.ts",
      "default": "./src/subscriptions/index.ts"
    },
    "./types/Pattern": {
      "import": "./dist/types/Pattern.js",
      "types": "./dist/types/Pattern.d.ts",
      "default": "./src/types/Pattern.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/rpc": "catalog:",
    "effect": "catalog:",
    "ulidx": "catalog:"
  },
  "devDependencies": {
    "@effect/sql": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
