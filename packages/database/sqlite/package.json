{
  "name": "@open-ontology/database-sqlite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown && tsc --declaration --emitDeclarationOnly --rootDir src --outDir dist",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@open-ontology/database": "workspace:*",
    "@open-ontology/database-sql": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
